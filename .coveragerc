[run]
source = src/openscientist
# SQLAlchemy's async API runs queries on greenlets; without this, every line
# after an awaited query in an async function is reported as never run.
concurrency = greenlet,thread
omit =
    */tests/*
    */__pycache__/*
    */.venv/*
relative_files = True
disable_warnings = no-data-collected
cover_pylib = False

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[paths]
source = src/openscientist
