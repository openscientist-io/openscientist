# OpenScientist Executor Container
# Minimal image for isolated Python code execution

FROM openscientist-base:latest

# Create non-root user for security. The GID is the job group the web chowns
# the job tree to; keep it in sync with job_container.identity (checked by the
# tests in tests/test_job_dir_permissions.py).
ARG EXECUTOR_UID=1000
ARG JOBS_GID=1001
RUN groupadd --gid ${JOBS_GID} jobs \
    && useradd --uid ${EXECUTOR_UID} --gid ${JOBS_GID} --create-home executor

WORKDIR /app

# Install system dependencies for scientific libraries and Rust
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libhdf5-dev \
    pkg-config \
    rustc \
    cargo \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Shared cargo home — registry and pre-built artifacts live here and are
# baked into the image so agent Rust code starts compiling immediately.
ENV CARGO_HOME=/usr/local/cargo
ENV CARGO_TARGET_DIR=/usr/local/cargo/target
ENV PATH="$CARGO_HOME/bin:$PATH"

# Pre-seed the cargo registry and compile all dependencies.
# The compiled artifacts are kept in CARGO_TARGET_DIR so subsequent
# cargo builds (same dep versions) reuse them without recompiling.
COPY cargo-seed /tmp/cargo-seed
RUN cargo build --manifest-path /tmp/cargo-seed/Cargo.toml \
    && rm -rf /tmp/cargo-seed \
    && chmod -R a+rwX $CARGO_HOME

# Install the `executor` extra from the lock. The base image already carries
# the main dependencies.
COPY pyproject.toml uv.lock README.md ./
RUN uv export --locked --no-dev --extra executor --no-emit-project --format requirements-txt \
        -o /tmp/requirements.txt \
    && uv pip install --system -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Create directories for data and output
RUN mkdir -p /data /output && chown executor:jobs /data /output

# Copy executor module
COPY src/openscientist_executor /app/openscientist_executor
COPY src/openscientist /app/openscientist

# Switch to non-root user
USER executor

# Run the executor module
ENTRYPOINT ["python", "-m", "openscientist_executor"]
