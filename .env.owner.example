# Read by the db-bootstrap, migrate and launcher services. Copy to .env.owner.
#
# Password of openscientist_owner, which owns the schema and runs migrations.
POSTGRES_OWNER_PASSWORD=
#
# Image digests the launcher accepts, written by `openscientist start` after
# each build; a rebuilt image is trusted again only after its digest is re-recorded.
# AGENT_IMAGE_DIGESTS=
# EXECUTOR_IMAGE_DIGESTS=
#
# The launcher's marker label, generated once by the setup wizard. Every
# container the launcher creates carries it; anything else answers 404.
# LAUNCHER_INSTANCE_ID=
#
# The web's uid and gid. The launcher's unix socket accepts only a caller
# whose uid and gid are both these, and the socket file is owned by them.
# LAUNCHER_WEB_UID=0
# LAUNCHER_WEB_GID=0
