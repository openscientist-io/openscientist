# Dockerfile.agent — openscientist-agent image
#
# Runs a single OpenScientist job in an isolated container.
# Builds on openscientist-base (Python 3.12, uv, git) and installs the full
# openscientist package so the agent can import orchestrator/discovery code.
#
# Build:
#   docker build -f Dockerfile.agent -t openscientist-agent:latest .
#
# Labels:
#   openscientist.job_id=<uuid>   set by JobContainerRunner at runtime
#   openscientist.type=agent

FROM openscientist-base:latest

# The air-gap firewall entrypoint sets nftables rules, then drops privileges
# with setpriv from util-linux.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nftables \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --uid 1001 --create-home --shell /bin/bash agent

WORKDIR /app

# Copy project files (README.md required by pyproject.toml readme field)
COPY pyproject.toml README.md uv.lock ./
COPY src/ ./src/

# Install dependencies including claude-agent-sdk and openai-codex (both listed
# in pyproject.toml). openai-codex brings the codex binary it is pinned to.
RUN uv export --locked --no-dev --no-emit-project --format requirements-txt \
        -o /tmp/requirements.txt \
    && uv pip install --system -r /tmp/requirements.txt \
    && uv pip install --system --no-deps -e . \
    && rm /tmp/requirements.txt

# omp harness CLI (OPENSCIENTIST_HARNESS=omp): pinned static binary onto PATH.
# The checksum is the release asset digest, not just the tag: a git tag is
# mutable and can be repointed at different bytes without this file changing,
# and this binary runs with the job's database credentials in its environment.
ARG OMP_VERSION=v18.12.6
ARG OMP_SHA256=85d9daf3a05fc76e8cd425ae1904eb576af8d21cc85fcf4690742626e07ccfa4
ARG OMP_RELEASE_BASE=https://github.com/can1357/oh-my-pi/releases/download
RUN curl -fsSL "${OMP_RELEASE_BASE}/${OMP_VERSION}/omp-linux-x64" -o /tmp/omp \
    && echo "${OMP_SHA256}  /tmp/omp" | sha256sum -c - \
    && install -m 0755 /tmp/omp /usr/local/bin/omp \
    && rm /tmp/omp

# Copy agent entrypoint
COPY docker/agent-entrypoint.py /agent-entrypoint.py

# Air-gapped egress firewall entrypoint (used when the runner enables airgap).
COPY docker/agent-firewall-entrypoint.sh /agent-firewall-entrypoint.sh
RUN chmod +x /agent-firewall-entrypoint.sh

# Switch to non-root user
USER agent

# Job directory will be mounted at /agent/job
WORKDIR /agent/job

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python", "/agent-entrypoint.py"]
