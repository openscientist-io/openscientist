# Dockerfile.agent — openscientist-agent image
#
# Runs a single OpenScientist job in an isolated container.
# Builds on openscientist-base (Python 3.12, uv, git) and installs the full
# openscientist package so the agent can import orchestrator/discovery code.
#
# Build:
#   docker build -f Dockerfile.agent -t openscientist-agent:latest .
#
# Labels:
#   openscientist.job_id=<uuid>   set by JobContainerRunner at runtime
#   openscientist.type=agent

# --- The pinned codex CLI ---------------------------------------------------
# Built separately by Dockerfile.codex and copied in, so this image needs no
# Rust toolchain and rebuilds in minutes. Override for a local build that has
# no registry access:
#   docker build -f Dockerfile.codex -t openscientist-codex:local .
#   docker build -f Dockerfile.agent --build-arg CODEX_IMAGE=openscientist-codex:local .
ARG CODEX_IMAGE=acrcbraindev.azurecr.io/openscientist-codex:8f8009fc
FROM ${CODEX_IMAGE} AS codex-build

FROM openscientist-base:latest

# Install system dependencies for native extensions (scipy, h5py, scanpy, etc.) and Rust.
# The libpango/cairo/gdk-pixbuf/glib stack is required by WeasyPrint, which renders
# final_report.pdf from the report HTML. Without it WeasyPrint fails to load
# libgobject-2.0-0 and the report falls back to the fpdf2 renderer, producing a PDF
# that does not match the HTML report shown in the UI.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libhdf5-dev \
    pkg-config \
    rustc \
    curl \
    ca-certificates \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    libffi8 \
    shared-mime-info \
    fonts-liberation \
    nftables \
    util-linux \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --uid 1001 --create-home --shell /bin/bash agent

WORKDIR /app

# Copy project files (README.md required by pyproject.toml readme field)
COPY pyproject.toml README.md uv.lock ./
COPY src/ ./src/

# Install dependencies including claude-agent-sdk and openai-codex (both listed
# in pyproject.toml). The official openai-codex bundles its codex binary only as
# a musl wheel, which is dropped via the uv override in pyproject.toml. The
# binary is provisioned separately below.
RUN uv export --locked --no-dev --no-emit-project --format requirements-txt \
        -o /tmp/requirements.txt \
    && uv pip install --system -r /tmp/requirements.txt \
    && uv pip install --system --no-deps -e . \
    && rm /tmp/requirements.txt

# Install the open-codex CLI built in the codex-build stage above (namespace
# tools, function apply_patch, web_search capability gate, and the apply_patch
# +-prefix description fix). Built from the fork rather than the upstream
# release because the open-weight fixes are not yet upstream. It goes on PATH at
# /usr/local/bin/codex, where CodexAgent._resolve_codex_bin (shutil.which) finds
# it.
COPY --from=codex-build /usr/local/bin/codex /usr/local/bin/codex
RUN chmod +x /usr/local/bin/codex

# omp harness CLI (OPENSCIENTIST_HARNESS=omp): pinned static binary onto PATH.
# The checksum is the release asset digest, not just the tag: a git tag is
# mutable and can be repointed at different bytes without this file changing,
# and this binary runs with the job's database credentials in its environment.
ARG OMP_VERSION=v17.1.5
ARG OMP_SHA256=35019bfa4d1acae0040ef1f3d91c29c6e7401acfcdbcfeba6ff506a6b103c987
ARG OMP_RELEASE_BASE=https://github.com/can1357/oh-my-pi/releases/download
RUN curl -fsSL "${OMP_RELEASE_BASE}/${OMP_VERSION}/omp-linux-x64" -o /tmp/omp \
    && echo "${OMP_SHA256}  /tmp/omp" | sha256sum -c - \
    && install -m 0755 /tmp/omp /usr/local/bin/omp \
    && rm /tmp/omp

# Copy agent entrypoint
COPY docker/agent-entrypoint.py /agent-entrypoint.py

# Air-gapped egress firewall entrypoint (used when the runner enables airgap).
COPY docker/agent-firewall-entrypoint.sh /agent-firewall-entrypoint.sh
RUN chmod +x /agent-firewall-entrypoint.sh

# Switch to non-root user
USER agent

# Job directory will be mounted at /agent/job
WORKDIR /agent/job

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python", "/agent-entrypoint.py"]
