# Dockerfile.agent — openscientist-agent image
#
# Runs a single OpenScientist job in an isolated container.
# Builds on openscientist-base (Python 3.12, uv, git) and installs the full
# openscientist package so the agent can import orchestrator/discovery code.
#
# Build:
#   docker build -f Dockerfile.agent -t openscientist-agent:latest .
#
# Labels:
#   openscientist.job_id=<uuid>   set by JobContainerRunner at runtime
#   openscientist.type=agent

# Java 21 runtime (for the optional Exomiser tool). python:3.12-slim is
# bookworm-based and has no openjdk-21 in its main repos, so copy the JRE from
# the official, version-pinned Temurin image rather than fighting apt.
FROM eclipse-temurin:21-jre AS jre

FROM openscientist-base:latest

# Install system dependencies for native extensions (scipy, h5py, scanpy, etc.) and Rust
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libhdf5-dev \
    pkg-config \
    rustc \
    && rm -rf /var/lib/apt/lists/*

# Self-contained Temurin JRE — Exomiser runs via `java -jar` (see openscientist_tools/exomiser.py).
# Only the runtime lives in the image; the Exomiser jar + ~80 GB data are bind-mounted
# from the host at /opt/exomiser (EXOMISER_HOST_PATH), not baked in.
COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="$JAVA_HOME/bin:${PATH}"

# Create non-root user
RUN useradd --uid 1001 --create-home --shell /bin/bash agent

WORKDIR /app

# Copy project files (README.md required by pyproject.toml readme field)
COPY pyproject.toml README.md uv.lock* ./
COPY src/ ./src/

# Install dependencies including claude-agent-sdk and openai-codex-sdk
# (both are listed in pyproject.toml dependencies)
RUN uv pip install --system -e .

# Install the Codex CLI binary for the Codex agent backend. The SDK ships
# only a Linux musl asset (static, runs on this glibc base). It lands in the
# SDK vendor dir where find_codex_path() resolves it.
RUN python -c "from openai_codex_sdk import Codex; Codex.install(version='rust-v0.135.0', filename='codex-x86_64-unknown-linux-musl.tar.gz')"

# Copy agent entrypoint
COPY docker/agent-entrypoint.py /agent-entrypoint.py

# Switch to non-root user
USER agent

# Job directory will be mounted at /agent/job
WORKDIR /agent/job

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

ENTRYPOINT ["python", "/agent-entrypoint.py"]
