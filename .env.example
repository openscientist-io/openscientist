# OpenScientist Environment Configuration
# Copy this file to .env and fill in your values.
#
# Loading priority: env vars > .env > defaults


#############################################
# SERVER
#############################################
# PORT=8080                                       # Host port docker compose publishes the web on
# OPENSCIENTIST_BIND_ADDRESS=127.0.0.1            # Host address the web port is published on. Loopback by default, so a public address exposes the port directly
# OPENSCIENTIST_BASE_URL=http://localhost:8080           # Base URL for notifications and share links
# APP_URL=<OPENSCIENTIST_BASE_URL>                # the wizard writes it, and the OAuth callback and the cookie's Secure flag follow it
# OPENSCIENTIST_MAX_CONCURRENT_JOBS=1                    # Max jobs running at the same time
# OPENSCIENTIST_MAX_CONCURRENT_CHATS=4                   # Max chat replies running at the same time
# Each chat container uses the OPENSCIENTIST_AGENT_MEMORY limit. Size chat concurrency to the host's available memory.
# OPENSCIENTIST_SCHEDULER_WINDOW_HOURS=24                # Hours of slot use per user that decide whose queued job starts next
# OPENSCIENTIST_RESTART_POLICY=unless-stopped           # docker compose restart policy for postgres and the web


#############################################
# PROVIDER SELECTION & MODEL OVERRIDES
#############################################
# Which LLM backend to use.
# One of: anthropic | cborg | vertex | bedrock | foundry | openai | azure-openai | ollama | vllm | llamacpp
OPENSCIENTIST_PROVIDER=anthropic

# Agent harness. Optional, default "auto" (derive from provider). Force with
# claude_code or codex (need a matching provider family), or omp (any provider).
# OPENSCIENTIST_HARNESS=auto
# OMP_AUTH_DIR=/home/you/.omp/agent                # omp harness: host vault dir of omp's stored logins, held by the web, which signs and refreshes it; the job container holds no vault.
#   The web rewrites agent.db on a token refresh, so the dir and agent.db must be writable by the web's uid (gid 1001). chgrp 1001 + chmod 2770 the dir, chgrp 1001 + chmod 0660 agent.db.
#   The openai provider's ChatGPT login (the vault's openai-codex row) routes through the codex harness only: the pinned omp binary pins that backend to chatgpt.com, so OPENSCIENTIST_HARNESS=omp with it is refused at launch.
# OPENSCIENTIST_CODEX_TURN_TIMEOUT=900                  # codex harness: seconds one agent turn may run, raise for slow backends

# Model overrides (optional — each provider has sensible defaults).
# OPENSCIENTIST_MODEL=claude-sonnet-5-5           # Main model
# OPENSCIENTIST_MODEL_CONTEXT_TOKENS=             # Main model's input window in tokens, when litellm and the built-in table do not know it (otherwise 8192)
# ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5-20251001  # Small/fast model for lightweight tasks
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001  # Model for in-page chat, when the main model rejects chat prompts (default: OPENSCIENTIST_MODEL)
# ANTHROPIC_DEFAULT_SONNET_MODEL=                 # Model Claude Code runs for its sonnet alias
# ANTHROPIC_DEFAULT_HAIKU_MODEL=                  # Model Claude Code runs for its haiku alias
# ANTHROPIC_DEFAULT_OPUS_MODEL=                   # Model Claude Code runs for its opus alias


#############################################
# PROVIDER CREDENTIALS (set the section for your chosen provider)
#############################################

# --- Option 1a: Direct Anthropic API ---
# Get your key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- Option 1b: Anthropic OAuth (from `claude login`) ---
# CLAUDE_CODE_OAUTH_TOKEN=  # run: claude setup-token

# --- Option 2: CBORG (Lawrence Berkeley National Lab) ---
# ANTHROPIC_AUTH_TOKEN=sk-ant-your-token-here
# ANTHROPIC_BASE_URL=https://api.cborg.lbl.gov

# --- Option 3: Google Vertex AI ---
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# GCP_CREDENTIALS_FILE=/path/to/service-account.json             # host path; mounted into the web container, which signs Vertex calls
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json      # the web's path to the mounted service account JSON
# GCP_BILLING_ACCOUNT_ID=XXXXXX-YYYYYY-ZZZZZZ
# CLOUD_ML_REGION=us-east5
# VERTEX_REGION_CLAUDE_4_5_SONNET=us-east5
# VERTEX_REGION_CLAUDE_4_5_HAIKU=us-east5

# --- Option 4: AWS Bedrock ---
# Held by the web, which signs every Bedrock call (SigV4 for keys/profiles, or injects the API key); the agent container holds no AWS credential.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_PROFILE=your-profile-name                   # alternative to access keys
# AWS_BEARER_TOKEN_BEDROCK=your-token             # alternative auth method
# Note: Bedrock model IDs need the "us." prefix, so set OPENSCIENTIST_MODEL accordingly

# --- Option 5: Azure AI Foundry ---
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# ANTHROPIC_FOUNDRY_API_KEY=your-azure-api-key
# ANTHROPIC_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/anthropic
#
# Azure Cost Management (optional — enables billing data in admin panel)
# Requires a service principal with "Cost Management Reader" role on the subscription/resource group.
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_RESOURCE_GROUP=your-resource-group      # optional; scopes query to one RG
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# --- Option 6: OpenAI (Codex agent backend) ---
# Set OPENSCIENTIST_PROVIDER=openai. Authenticate one of two ways:
# OPENAI_API_KEY=sk-your-openai-key                # API auth, or...
# CODEX_AUTH_FILE=/home/you/.codex/auth.json       # ChatGPT login (from `codex login`). Host path mounted into the web container, which signs the Codex calls upstream with it; the job container holds no ChatGPT credential
#   The web rewrites the file in place on a token refresh (a single-file mount cannot be replaced), so the file must be writable by the web's uid (gid 1001). chgrp 1001 + chmod 0660.

# --- Option 7: Azure OpenAI Service (Codex agent backend, OpenAI models via Azure) ---
# Set OPENSCIENTIST_PROVIDER=azure-openai and OPENSCIENTIST_MODEL to the deployment name.
# AZURE_OPENAI_API_KEY=your-azure-openai-key       # sent as a Bearer token
# AZURE_OPENAI_RESOURCE=your-resource              # the <resource> in https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=                        # optional, preview for preview features, sent on every request when set (dated versions are refused)
# AZURE_OPENAI_STREAM_MAX_RETRIES=10               # stream reconnects before a turn fails, raise for deployments that disconnect often

# --- Option 8: Ollama (omp-driven, open-weight models served locally) ---
# Set OPENSCIENTIST_PROVIDER=ollama. Local and keyless: no API key needed.
# OLLAMA_BASE_URL=http://localhost:11434/v1        # use http://host.docker.internal:11434/v1 from inside the agent container
# Ollama reports its served window only for a model already in memory, and at job
# launch nothing is. Set OPENSCIENTIST_MODEL_CONTEXT_TOKENS to the num_ctx the
# server runs with, otherwise prompts are budgeted against a conservative default.

# --- Option 9: vLLM (omp-driven, self-hosted OpenAI-compatible server) ---
# Set OPENSCIENTIST_PROVIDER=vllm and name the served model in OPENSCIENTIST_MODEL.
# VLLM_BASE_URL=http://localhost:8000/v1           # use http://host.docker.internal:8000/v1 from inside the agent container
# VLLM_API_KEY=                                    # only if you launched vLLM with --api-key

# --- Option 10: llama.cpp (omp-driven, self-hosted OpenAI-compatible server) ---
# Set OPENSCIENTIST_PROVIDER=llamacpp and name the served model in OPENSCIENTIST_MODEL.
# LLAMACPP_BASE_URL=http://localhost:8080/v1       # use http://host.docker.internal:8080/v1 from inside the agent container
# LLAMACPP_API_KEY=                                # only if you launched llama-server with --api-key
# The context window is read from llama.cpp's /props at job launch and passed in.
# Set OPENSCIENTIST_MODEL_CONTEXT_TOKENS only to override it.


#############################################
# DATABASE
#############################################
# Docker: docker-compose.yml constructs DATABASE_URL from these + service hostname.
# The superuser password lives in .env.db and the owner's in .env.owner, which the
# web never loads. The web refuses to start if either reaches it.
POSTGRES_USER=openscientist
POSTGRES_DB=openscientist
# Password of the web's own openscientist_web login. Required, with no default.
POSTGRES_WEB_PASSWORD=
# Password of the BYPASSRLS openscientist_admin login. Required, with no default.
POSTGRES_ADMIN_PASSWORD=
# Host port, bound to 127.0.0.1. Avoids conflicts with other PostgreSQL instances.
POSTGRES_PORT=5434

# App: the web needs both DATABASE_URL and ADMIN_DATABASE_URL (required).
# For local dev (no Docker), set these directly:
DATABASE_URL=postgresql+asyncpg://openscientist_web:POSTGRES_WEB_PASSWORD@localhost:5434/openscientist
ADMIN_DATABASE_URL=postgresql+asyncpg://openscientist_admin:POSTGRES_ADMIN_PASSWORD@localhost:5434/openscientist
# Migrations on the host log in as the owner. The password comes from .env.owner.
OWNER_DATABASE_URL=postgresql+asyncpg://openscientist_owner@localhost:5434/openscientist
# SQL_ECHO=false                                  # Set true to log all SQL queries


#############################################
# SECRETS
#############################################
# Master secret — derives storage_secret and token_encryption_key via HMAC-SHA256.
# Generate with: openssl rand -hex 32
OPENSCIENTIST_SECRET_KEY=your-64-char-hex-master-secret-here


#############################################
# OAUTH (optional — enables real user login)
#############################################
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# GitHub OAuth
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ORCID OAuth (https://orcid.org/developer-tools)
# ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
# ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional bootstrap admins (comma-separated exact emails).
# Matching verified OAuth logins are auto-granted admin and approved status.
# BOOTSTRAP_ADMIN_EMAILS=admin1@example.org,admin2@example.org

# SESSION_DURATION_DAYS=30                        # Session cookie lifetime in days

# GitHub token for skill syncing from private repos (optional)
# GITHUB_TOKEN=ghp_your-token-here


#############################################
# BUDGET LIMITS (optional — all have safe defaults)
#############################################
# Only seed the admin settings row on first start; from then on the Settings tab counts.
# MAX_JOB_COST_USD=10.0                           # Per-job cost cap
# MAX_PROJECT_SPEND_TOTAL_USD=inf                 # Total project spend limit
# MAX_PROJECT_SPEND_24H_USD=inf                   # 24-hour spend limit
# WARN_PROJECT_SPEND_24H_USD=inf                  # 24-hour warning threshold


#############################################
# CONTAINER ISOLATION (optional)
#############################################
# OPENSCIENTIST_AGENT_IMAGE=openscientist-agent:latest  # Docker image for per-job agent containers
# OPENSCIENTIST_AGENT_NETWORK=                           # Docker network for job containers (default: the launcher's)
# OPENSCIENTIST_AGENT_TIMEOUT=14400                      # Seconds before a running job container fails as timed out
# OPENSCIENTIST_EXECUTOR_IMAGE=openscientist-executor:latest    # Docker image for code execution
# OPENSCIENTIST_EXECUTOR_MEMORY=2g                       # Executor memory limit
# OPENSCIENTIST_EXECUTOR_CPU=0.5                         # Executor CPU limit
# OPENSCIENTIST_EXECUTOR_TIMEOUT=120                     # Executor wall-clock timeout in seconds, the cap the execution broker clamps request timeouts to
# OPENSCIENTIST_EXECUTOR_PIDS_LIMIT=4096
# OPENSCIENTIST_EXECUTOR_MAX_CONCURRENT_PER_JOB=2
# OPENSCIENTIST_LAUNCHER_SOCKET_PATH=/run/launcher/launcher.sock  # Unix socket of the launcher service (the default shown)
# OPENSCIENTIST_AGENT_MEMORY=8g                          # Agent container memory limit
# OPENSCIENTIST_AGENT_CPU=2.0                            # Agent container CPU limit
# OPENSCIENTIST_AGENT_PIDS_LIMIT=4096
# OPENSCIENTIST_CONTAINER_APP_DIR=/app                   # App path inside container
# OPENSCIENTIST_HOST_PROJECT_DIR=                        # Absolute host path of this checkout; `uv run openscientist` records it, and the launcher binds job directories from <it>/jobs
#
# LAUNCHER: the launcher service's own values, written by the wizard and by `uv run openscientist`.
# Its environment holds these and nothing else, so the Docker-socket holder reads no credential.
# AGENT_IMAGE_DIGESTS=                                   # sha256 digests of the agent image, re-recorded after each build. The launcher accepts only the recorded set
# EXECUTOR_IMAGE_DIGESTS=                                # the same for the executor image
# LAUNCHER_INSTANCE_ID=                                  # the launcher's marker label, generated once by the setup wizard. Every container it creates carries it, and anything else answers 404
# LAUNCHER: hard bounds the launcher service enforces on the values the web may ask for
# LAUNCHER_AGENT_MAX_MEMORY_MIB=16384                    # Max agent container memory in MiB
# LAUNCHER_AGENT_MAX_CPU=8                               # Max agent container CPUs
# LAUNCHER_AGENT_MAX_PIDS=4096
# LAUNCHER_EXECUTOR_MAX_MEMORY_MIB=8192                  # Max executor container memory in MiB
# LAUNCHER_EXECUTOR_MAX_CPU=4                            # Max executor container CPUs
# LAUNCHER_EXECUTOR_MAX_PIDS=4096
# LAUNCHER_MAX_LIFETIME_SECONDS=86400                    # Max agent container lifetime in seconds
# LAUNCHER_MAX_EGRESS_ENTRIES=64                         # Max firewall allow-list entries per container
# LAUNCHER_JOBS_FREE_SPACE_RESERVE_MIB=1024               # Jobs filesystem reserve checked before launches and every second
# Put `<OPENSCIENTIST_HOST_PROJECT_DIR>/jobs` on a dedicated filesystem, separate from PostgreSQL and Docker data.
# Sampling cannot stop writes between checks. Per-job hard quotas require a quota-capable backing store.
# Docker bind mounts have no size cap (https://docs.docker.com/engine/storage/bind-mounts/).
# Writable-layer quotas depend on the storage driver (https://docs.docker.com/reference/cli/docker/container/run/#storage-opt).
# OPENSCIENTIST_PLATFORM=linux/amd64                     # Docker platform for web container (unset = native)
# OPENSCIENTIST_AGENT_PLATFORM=linux/amd64               # Docker platform for agent containers (set to linux/amd64 on Apple Silicon for Phenix)
# OPENSCIENTIST_LLM_PROXY_PORT=8081                      # Web's LLM proxy port that agent containers call
# OPENSCIENTIST_EXEC_BROKER_PORT=8082                    # Web's execution broker port that agent containers call

# MAX_FILE_SIZE_MB=1000                           # Max upload size in MB per file and per request total
# MAX_AGENT_SKILLS=10                             # Max skills per agent job

# OPENSCIENTIST_PUBLIC_PDF_MEMORY_MB=1024
# OPENSCIENTIST_PUBLIC_PDF_CPU_SECONDS=15
# OPENSCIENTIST_PUBLIC_PDF_TIMEOUT_SECONDS=30
# OPENSCIENTIST_PUBLIC_PDF_MAX_CONCURRENT=2


#############################################
# AIR-GAPPED MODE (optional)
#############################################
# Job and executor containers always run behind an in-container nftables
# firewall that installs its rules as root and then drops to the unprivileged
# run user, so the container cannot undo them. In default mode the firewall
# keeps public egress open and drops the cloud metadata endpoint
# (169.254.169.254 and fd00:ec2::254), the link-local ranges
# (169.254.0.0/16, fe80::/10), the host gateway and the private ranges
# (10/8, 172.16/12, 192.168/16, 100.64/10, fc00::/7), keeping Postgres, the
# internal execution broker and the LLM proxy reachable. When on, the
# firewall instead blocks all egress except the allowlist below, and the
# executor containers that run model-written code launch with no network at
# all. It also routes search_pubmed to a local PubMed corpus in Postgres
# instead of NCBI (load it once with: python -m openscientist.pubmed_mirror).
# Push notifications through `ntfy.sh` are unavailable in air-gapped mode.
#
# What the job container may reach is the same for every provider: Postgres,
# the internal execution broker, and the web's LLM proxy, and nothing else.
# The web holds every provider credential and signs each upstream call itself
# (API keys and tokens as headers, SigV4 for Bedrock, the service account for
# Vertex), so no provider credential and no public egress lives in the job
# container.
# Air-gapped agents cannot use Docker's embedded DNS resolver after startup.
# The launcher pins allowlisted IPv4 addresses in `/etc/hosts` through Docker's `extra_hosts`.
#
# OPENSCIENTIST_AIRGAPPED=false


#############################################
# PHENIX (optional — structural biology tools)
#############################################
# Phenix 2.x is mounted read-only at /opt/phenix inside all containers.
# You MUST use a Linux x86_64 Phenix build (even when developing on macOS),
# because all containers run Linux.
#
# Setup:
#   1. Download the Linux x86_64 installer from https://phenix-online.org
#      (free for academics; choose "Phenix installer for Linux x86_64").
#   2. Run the installer on a Linux host (or via a Linux container on macOS):
#        bash Phenix-2.0-*-Linux-x86_64.sh -b -p /path/to/phenix-2.0-XXXX
#      Note: on macOS, install into a case-sensitive APFS volume
#      (the default case-insensitive one collides on some bundled files).
#   3. Set PHENIX_HOST_PATH to the install directory below.
#
# PHENIX_HOST_PATH=/path/to/phenix-2.0-5936


#############################################
# BERKELEY LAB DATA LAKEHOUSE (optional)
#############################################
# DREMIO_USER=your-dremio-username
# DREMIO_PASSWORD=your-dremio-password


#############################################
# DEVELOPMENT
#############################################
# Dev mode enables mock OAuth login and other development features.
# The web refuses to start with it unless APP_URL is a local http address
# (localhost, 127.0.0.1 or ::1) and OPENSCIENTIST_BIND_ADDRESS is loopback.
OPENSCIENTIST_DEV_MODE=false
# SIMULATE_PROVIDER_ERROR=false                   # Report the provider as misconfigured, to test the error banner
