# OpenScientist Base Image
# Common dependencies shared across main and executor containers
#
# Contains: Python 3.12, uv
# Rebuild only when these dependencies change (rare)

FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30

# Install system dependencies
# WeasyPrint requires: pango, cairo, harfbuzz, gdk-pixbuf (for PNG/JPEG), and
# the fonts the web and the agent render reports with. CI installs this list
# too, reading one package per line, so keep that layout
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    jq \
    fonts-dejavu-core \
    fonts-noto-core \
    fonts-liberation \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libpangocairo-1.0-0 \
    libharfbuzz0b \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    shared-mime-info \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management, from the digest-pinned
# official image. No installer script is fetched from astral.sh at build time
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /uvx /bin/

WORKDIR /app

# Copy dependency manifests
COPY pyproject.toml uv.lock README.md ./

# Stub package so uv can do the editable install
RUN mkdir -p src/openscientist && touch src/openscientist/__init__.py

# Install deps from the lock: `uv pip install -e .` re-resolves pyproject and
# ignores uv.lock, which floated mcp to 2.x and broke the tools MCP server.
# --no-deps keeps the project install from pulling anything unlocked back in.
RUN uv export --locked --no-dev --no-emit-project --format requirements-txt \
        -o /tmp/requirements.txt \
    && uv pip install --system -r /tmp/requirements.txt \
    && uv pip install --system --no-deps -e . \
    && rm /tmp/requirements.txt

# Smoke test: verify WeasyPrint can render text + images
RUN python -c "\
import base64, pathlib, weasyprint; \
png = base64.b64decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8/5+hHgAHggJ/PchI7wAAAABJRU5ErkJggg=='); \
pathlib.Path('/tmp/test.png').write_bytes(png); \
weasyprint.HTML(string='<h1>test</h1><img src=\"/tmp/test.png\">').write_pdf('/tmp/test.pdf'); \
assert pathlib.Path('/tmp/test.pdf').stat().st_size > 500, 'PDF too small - image likely not embedded'; \
pathlib.Path('/tmp/test.png').unlink(); pathlib.Path('/tmp/test.pdf').unlink(); \
print('WeasyPrint smoke test passed (text + image)')"
